# ZBC semihosting test wrapper for MAME
#
# Detects target architecture from ELF and runs appropriate MAME machine

# Find MAME executable
if [ -n "$MAME" ]; then
    mame="$MAME"
elif [ -x "$HOME/git/mame/mame" ]; then
    mame="$HOME/git/mame/mame"
elif command -v mame >/dev/null 2>&1; then
    mame="mame"
else
    echo "Error: MAME not found. Set MAME environment variable or install mame." >&2
    exit 77
fi

# ELF file is first argument
elf="$1"
shift

if [ ! -f "$elf" ]; then
    echo "Error: ELF file not found: $elf" >&2
    exit 1
fi

# Detect architecture from ELF header
# Try llvm-readelf first (needed for MOS), fall back to readelf
# Check common locations for llvm-readelf
llvm_readelf=""
if command -v llvm-readelf >/dev/null 2>&1; then
    llvm_readelf="llvm-readelf"
elif [ -x "$HOME/git/llvm-mos/build/install/bin/llvm-readelf" ]; then
    llvm_readelf="$HOME/git/llvm-mos/build/install/bin/llvm-readelf"
fi

if [ -n "$llvm_readelf" ]; then
    elf_machine=$("$llvm_readelf" -h "$elf" 2>/dev/null | awk '/Machine:/ { print $2 }')
else
    elf_machine=$(readelf -h "$elf" 2>/dev/null | awk '/Machine:/ { print $2 }')
fi

case "$elf_machine" in
    MOS)
        machine=zbcm6502
        ;;
    *)
        echo "Unsupported architecture: $elf_machine" >&2
        exit 77
        ;;
esac

# Check if MAME supports this machine
if ! "$mame" -listfull "$machine" >/dev/null 2>&1; then
    echo "Skipping: MAME does not support machine '$machine'" >&2
    exit 77
fi

# Timeout in seconds (default 60, can be overridden via ZBC_TIMEOUT)
timeout="${ZBC_TIMEOUT:-60}"

# Run MAME headless (no video window)
export SDL_VIDEODRIVER=dummy

# Run MAME with the ELF
# -video none: no video output (headless)
# -skip_gameinfo: skip the startup info screen
# -elfload: load ELF file directly
# -seconds_to_run: timeout for test execution
exec "$mame" "$machine" \
    -video none \
    -skip_gameinfo \
    -elfload "$elf" \
    -seconds_to_run "$timeout" \
    "$@"
